{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "openapi:generate": {
      "dependsOn": ["@launchway/api#openapi:export"],
      "inputs": ["../api/openapi.json"],
      "outputs": ["src/lib/api/schema.gen.ts"]
    },
    "build": {
      "dependsOn": ["^build", "openapi:generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "openapi:generate"]
    },
    "test": {
      "dependsOn": ["openapi:generate"]
    },
    "dev": {
      "dependsOn": ["openapi:generate"],
      "cache": false,
      "persistent": true
    }
  }
}
