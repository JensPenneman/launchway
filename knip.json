{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/contracts": {
      "project": ["src/**/*.ts"]
    },
    "apps/api": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "apps/agent": {
      "entry": ["src/index.ts", "src/healthcheck.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/routes/**/*.tsx", "src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"],
      "ignore": ["src/routeTree.gen.ts", "src/lib/api/schema.gen.ts"]
    }
  },
  "ignoreExportsUsedInFile": true
}
