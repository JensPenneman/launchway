# Local development settings for `pnpm --filter @slipway/agent dev` (copy to .env).
SLIPWAY_SERVER_URL=ws://localhost:3000
# One-time join token from the UI (Nodes -> Add node); only needed until the agent has joined.
SLIPWAY_JOIN_TOKEN=
# Keep development state out of /var/lib/slipway.
SLIPWAY_WORKSPACE=./.workspace
LOG_LEVEL=debug
