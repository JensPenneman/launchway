# Local development settings for `pnpm dev` (copy to .env; never commit .env).
# PostgreSQL from compose.dev.yaml at the repository root.
DATABASE_URL=postgres://slipway:slipway@localhost:5432/slipway
# 32 random bytes, base64. Generate one with: openssl rand -base64 32
SLIPWAY_SECRET_KEY=
SLIPWAY_LISTEN=127.0.0.1:3000
SLIPWAY_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
