# Generated by Launchway from its routes. Changes made here are overwritten.
{
	admin unix//run/caddy-admin/admin.sock|0222
	email ops@example.com
	cert_issuer acme
}

(gate) {
	forward_auth http://gate-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
	}
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d402 (app): placeholder (503), app idle has no running deployment
idle.example.com {
	import gate
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	request_header -X-API-KEY
	header Content-Type "text/html; charset=utf-8"
	header Cache-Control "no-store"
	header Retry-After "30"
	respond <<HTML
		<!doctype html>
		<html lang="en">
		<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>idle.example.com &mdash; deployment in progress / not running</title>
		</head>
		<body style="font-family: system-ui, sans-serif; margin: 3rem">
		<h1>idle.example.com</h1>
		<p>Deployment in progress / not running. Try again in a moment.</p>
		</body>
		</html>
		HTML 503
}

