# Generated by Launchway from its routes. Changes made here are overwritten.
{
	admin unix//run/caddy-admin/admin.sock|0222
	email ops@example.com
	cert_issuer acme
}

(gate) {
	forward_auth http://login-oauth2-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
	}
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d401 (app)
login.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	handle /oauth2/* {
		reverse_proxy login-oauth2-proxy:4180
	}
	@closed path /setup* /signup* /api/signup*
	respond @closed 404
	request_header -X-API-KEY
	reverse_proxy login-pocket-id:1411
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d402 (app)
trail.example.com {
	import gate
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy trail-web:8080
}
