{
  "name": "@launchway/api",
  "version": "0.2.0",
  "private": true,
  "description": "Launchway control plane: REST API, OpenAPI document and host of the web UI.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsx watch --conditions=@launchway/source --env-file-if-exists=.env src/index.ts | pino-pretty",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@launchway/source --env-file-if-exists=.env scripts/migrate.ts",
    "openapi:export": "tsx --conditions=@launchway/source scripts/export-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@hono/zod-openapi": "1.6.3",
    "@launchway/contracts": "workspace:*",
    "@octokit/auth-app": "8.3.1",
    "@octokit/rest": "22.0.1",
    "@scalar/hono-api-reference": "0.12.10",
    "@simplewebauthn/server": "14.0.3",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@launchway/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "12.2.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/ws": "catalog:",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "catalog:",
    "testcontainers": "12.2.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
