# Generated by Launchway from its routes. Changes made here are overwritten.
{
	admin unix//run/caddy-admin/admin.sock|0222
	email ops@example.com
	cert_issuer acme
}

(gate) {
	forward_auth http://gate-proxy:4180 {
		uri /oauth2/auth
		copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Groups
	}
}

# Launchway
deploy.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy launchway:3000
}

# deploy.example.com: skipped, the host name is already served

# route rt_01jbh8m4x2f8k9z0a1b2c3d408 (redirect)
docs.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	redir https://example.com/docs?from=old 307
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d410 (external)
forced.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy http://host.docker.internal:7878
}

# idle.example.com: skipped, app idle has no running deployment

# route rt_01jbh8m4x2f8k9z0a1b2c3d405 (external)
nas.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy https://nas.lan:5001 {
		transport http {
			tls_server_name nas.lan
		}
	}
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d407 (redirect)
old.example.com {
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	redir https://new.example.com{uri} 308
}

# pending.example.com: skipped, DNS preflight not passed (pending)

# route rt_01jbh8m4x2f8k9z0a1b2c3d404 (external)
radarr.example.com {
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy http://host.docker.internal:7878
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d402 (app)
shop.example.com {
	encode zstd gzip
	reverse_proxy 192.168.1.30:18080
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d401 (app)
trail.example.com {
	import gate
	encode zstd gzip
	header ?Strict-Transport-Security "max-age=31536000"
	reverse_proxy trail-web:8080
}

# route rt_01jbh8m4x2f8k9z0a1b2c3d406 (external)
v6.example.com {
	reverse_proxy http://[fd00::10]:8000
}
