# Local development settings for `pnpm --filter @launchway/agent dev` (copy to .env).
LAUNCHWAY_SERVER_URL=ws://localhost:3000
# One-time join token from the UI (Nodes -> Add node); only needed until the agent has joined.
LAUNCHWAY_JOIN_TOKEN=
# Keep development state out of /var/lib/launchway.
LAUNCHWAY_WORKSPACE=./.workspace
LOG_LEVEL=debug
