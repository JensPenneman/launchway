# Local development settings for `pnpm dev` (copy to .env; never commit .env).
# PostgreSQL from compose.dev.yaml at the repository root.
DATABASE_URL=postgres://launchway:launchway@localhost:5432/launchway
# LAUNCHWAY_SECRET_KEY: 32 random bytes, base64. Append one with:
#   echo "LAUNCHWAY_SECRET_KEY=$(openssl rand -base64 32)" >> .env
LAUNCHWAY_LISTEN=127.0.0.1:3000
LAUNCHWAY_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
