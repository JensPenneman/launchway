# Launchway configuration, read by Docker Compose from the .env file next to
# compose.yaml.
#
# install.sh / install.ps1 create .env for you: they fill in the values marked
# "Generated" and never overwrite a value that is already set, so running the
# installer again is safe. To set it up by hand, copy this file to .env and fill
# in every empty value except LAUNCHWAY_PUBLIC_URL.
#
# Back up .env. Losing LAUNCHWAY_SECRET_KEY makes every stored secret (environment
# variables, DNS provider credentials, GitHub App keys and tokens) unrecoverable, and the database only accepts the POSTGRES_PASSWORD it was
# created with.

# Image tag of the Launchway images: a release such as 0.1.0 (a leading "v" is
# dropped by the installer), a release line such as 0.1, edge, or latest.
LAUNCHWAY_VERSION=latest

# Host port of the web UI and API. Used for the first-run setup, before a
# domain is configured. Ports 80 and 443 belong to the Caddy edge proxy.
LAUNCHWAY_PORT=3000

# Public URL of the platform, for example https://deploy.example.com.
# Optional: overrides the URL configured in the settings.
LAUNCHWAY_PUBLIC_URL=

# Contact e-mail for Let's Encrypt (ACME) certificates. Required.
LAUNCHWAY_ACME_EMAIL=

# Generated. Key that encrypts secrets at rest: 32 random bytes, base64.
#   head -c 32 /dev/urandom | base64
LAUNCHWAY_SECRET_KEY=

# Generated. Join token of the bundled agent on this machine:
# "lwyn_" followed by 43 characters from A-Z, a-z and 0-9.
#   printf 'lwyn_%s\n' "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 43)"
LAUNCHWAY_LOCAL_JOIN_TOKEN=

# Generated. The first-run setup (creating the owner) requires this token, so
# whoever reaches port 3000 before you cannot claim the instance. The installer
# prints a setup link with it. Unset: setup needs no token.
#   printf 'lwys_%s\n' "$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 43)"
LAUNCHWAY_SETUP_TOKEN=

# Generated. Password of the bundled PostgreSQL database (hex). Changing it
# later requires changing it inside the database as well.
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
POSTGRES_PASSWORD=

# Log level: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info
